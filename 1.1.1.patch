 /**
  * Module variables.
@@ -174,6 +174,14 @@ app.handle = function handle(req, res, callback) {
     res.locals = Object.create(null);
   }
 
+  // ensure req.originalUrl is set for sub-apps
+  // the router will also set it, but setting it here ensures
+  // it is available for any middleware that runs before the router
+  // and correctly preserves the original URL before any path stripping
+  if (!req.originalUrl) {
+    req.originalUrl = req.url;
+  }
+
   this.router.handle(req, res, done);
 };
 
